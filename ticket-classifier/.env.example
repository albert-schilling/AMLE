ANTHROPIC_API_KEY=SOME_API_KEY

# Optional variables
LOG_LEVEL=INFO
# LOG_FILE=output/ticket-classifier.log
# JSON Lines trace, one line per agent step
# TRACE_FILE=output/trace.jsonl

MODEL="claude-haiku-4-5"
MAX_TOKENS=4000
MAX_ITERATIONS=6
# Extended thinking tokens per reply, logged in the trace. 0 = off.
# Must be >= 1024 and below MAX_TOKENS (raise MAX_TOKENS too). Costs extra tokens.
THINKING_BUDGET=2000

TICKETS_PATH=fixtures/tickets.json
CUSTOMERS_PATH=fixtures/customers.json
RESULTS_PATH=output/results.json
