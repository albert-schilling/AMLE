ANTHROPIC_API_KEY=SOME_API_KEY

# Optional variables
LOG_LEVEL=INFO
# LOG_FILE=output/ticket-classifier.log
# JSON Lines trace, one line per workflow event
# TRACE_FILE=output/trace.jsonl

MODEL="claude-haiku-4-5"
MAX_TOKENS=4000
# Model and output limit for the drafted reply; the model defaults to MODEL
# REPLY_MODEL="claude-haiku-4-5"
# REPLY_MAX_TOKENS=1000

TICKETS_PATH=fixtures/tickets.json
CUSTOMERS_PATH=fixtures/customers.json
RESULTS_PATH=output/results.json
GRAPH_PATH=output/graph.mmd
CHECKPOINT_PATH=output/checkpoints.db

# OpenTelemetry: traces, metrics and logs to the local monitoring stack (make obs-up)
OTEL_ENABLED=false
# OTEL_SERVICE_NAME=ticket-classifier
# Collector OTLP HTTP endpoint; set empty to print telemetry to the console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=amle,deployment.environment.name=local

# Knowledge base in PostgreSQL (make db-up); password from database/.env
# KNOWLEDGE_DATABASE_URL=postgresql://ticket_classifier:PASSWORD@localhost:5432/knowledge
# KNOWLEDGE_BASE_PATH=data/knowledge_base
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_PATH=output/fastembed
# Words per chunk and words shared by neighbouring chunks (overlap < size)
# CHUNK_SIZE=60
# CHUNK_OVERLAP=20
# Passages per ticket
# KNOWLEDGE_TOP_K=3
# Leave out passages below this similarity (-1 to 1)
# KNOWLEDGE_MIN_SCORE=0.65
# Labelled questions for make kb-eval
# KNOWLEDGE_QUESTIONS_PATH=data/eval/knowledge_questions.json
