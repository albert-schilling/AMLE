      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"ticket-classifier\" && name=~\"ticket\\\\.(run|resume)\" && span.ticket.reused = nil && span.ticket_id=~\"$ticket_id\"} | select(span.ticket_id, span.run_mode, span.ticket.status, span.category, span.priority)",
          "tableType": "spans",
          "limit": 50,
          "spss": 10,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
