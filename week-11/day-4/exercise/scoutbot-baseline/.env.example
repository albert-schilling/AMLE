ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: force the planner's model instead of letting it tier by ticket difficulty
# (leave unset and planner.plan_ticket picks cheap/strong via metering.pick_model).
# ANTHROPIC_PLAN_MODEL=claude-sonnet-5
# Optional: the model the LLM-as-judge uses (W11D3). Defaults to the strong tier - judging is a
# batch/offline cost, not per-ticket, so it can afford it. Set cheaper to save on large eval runs.
# ANTHROPIC_JUDGE_MODEL=claude-sonnet-5
